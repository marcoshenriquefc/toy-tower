# ============================================================================
# VARIÁVEIS DE AMBIENTE DO RENDER — SERVIDOR SOCKET.IO (/socket-server)
# Root Directory: socket-server
# Build Command:  npm install && npm run build
# Start Command:  npm run start
# ============================================================================

# Porta HTTP injetada pelo Render (default: 4000)
PORT="4000"

# Domínio do Frontend hospedado na Vercel (permite múltiplos separados por vírgula)
FRONTEND_URL="https://toy-tower.vercel.app"

# String de conexão do MongoDB Atlas (mesmo banco usado pela API Serverless da Vercel)
MONGODB_URI="mongodb+srv://<usuario>:<senha>@cluster0.xxxxx.mongodb.net/toytower?retryWrites=true&w=majority"

# Chave secreta compartilhada com a Vercel para validar o JWT no handshake (socket.handshake.auth.token)
JWT_SECRET="chave-secreta-super-segura-compartilhada-vercel-render-2026"
