# ============================================================================
# ARQUITETURA HÍBRIDA DE DEPLOY — TOY TOWER
# 1. VERCEL: Frontend (HTML5 Canvas / Matter.js / Vue) + API Serverless (/api/auth/*)
# 2. RENDER: Servidor Dedicado WebSocket (Socket.io em /socket-server)
# ============================================================================

# ----------------------------------------------------------------------------
# [BLOCO 1 — VARIÁVEIS DA VERCEL (Frontend + API Serverless)]
# Configure estas variáveis no painel da Vercel (Settings -> Environment Variables)
# ----------------------------------------------------------------------------

# Client ID público do Google OAuth 2.0 (usado no Frontend pelo Google Identity Services)
VITE_GOOGLE_CLIENT_ID="seu-client-id-do-google.apps.googleusercontent.com"

# Credenciais do Google OAuth 2.0 no Backend Serverless (/api/auth/google)
GOOGLE_CLIENT_ID="seu-client-id-do-google.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret-do-google"

# String de conexão do MongoDB Atlas (reutilizada via global._mongooseCache nas funções Serverless)
MONGODB_URI="mongodb+srv://<usuario>:<senha>@cluster0.xxxxx.mongodb.net/toytower?retryWrites=true&w=majority"

# Chave secreta para assinar e validar o JWT (DEVE SER EXATAMENTE A MESMA NA VERCEL E NO RENDER)
JWT_SECRET="chave-secreta-super-segura-compartilhada-vercel-render-2026"

# URL pública do servidor Socket.io hospedado no Render (sem barra no final)
# Usada pelo socket.io-client e pelo Wake-up Ping automático (GET ${VITE_SOCKET_URL}/health)
VITE_SOCKET_URL="https://toy-tower-socket.onrender.com"
NUXT_PUBLIC_SOCKET_URL="https://toy-tower-socket.onrender.com"


# ----------------------------------------------------------------------------
# [BLOCO 2 — VARIÁVEIS DO RENDER (Web Service Node.js em /socket-server)]
# Configure estas variáveis no painel do Render (Environment -> Environment Variables)
# Build Command: npm install && npm run build
# Start Command: npm run start
# Root Directory: socket-server
# ----------------------------------------------------------------------------

# Porta HTTP injetada pelo Render (padrão local: 4000)
PORT="4000"

# Domínio do Frontend na Vercel autorizado pelo CORS estrito do Socket.io
# (Aceita também http://localhost:3000 e http://localhost:5173 em desenvolvimento)
FRONTEND_URL="https://toy-tower.vercel.app"

# Mesma string de conexão do MongoDB Atlas usada na Vercel
# MONGODB_URI="mongodb+srv://<usuario>:<senha>@cluster0.xxxxx.mongodb.net/toytower?retryWrites=true&w=majority"

# Mesma chave secreta JWT usada na Vercel para validar socket.handshake.auth.token no io.use(...)
# JWT_SECRET="chave-secreta-super-segura-compartilhada-vercel-render-2026"
